{
  "name": "@mapre/cli",
  "version": "0.1.0",
  "description": "Command-line interface for mapre: scaffold and build markdown presentations",
  "type": "module",
  "license": "MIT",
  "author": "Peter Kranz (kratec GmbH)",
  "homepage": "https://github.com/kratecorg/mapre#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kratecorg/mapre.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kratecorg/mapre/issues"
  },
  "keywords": [
    "mapre",
